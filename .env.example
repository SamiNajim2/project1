# Copy to .env.local and fill in real values.

# --- Anthropic (required, server-only). Used only to draft narrative text. ---
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-opus-5.
# ANTHROPIC_MODEL=

# --- Supabase: Dashboard -> Project Settings -> API keys ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SECRET, server-only. Bypasses Row Level Security (creates users, writes subscription status).
SUPABASE_SECRET_KEY=sb_secret_...
# Only for running supabase/migrations by hand (session pooler, IPv4). The app does not use them.
SUPABASE_DB_PASSWORD=
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Stripe: Dashboard -> Developers -> API keys (sk_test_ keys in the sandbox) ---
STRIPE_SECRET_KEY=sk_test_...
# The Finance Analyst Pro $20/month price (lookup key finance_analyst_pro_monthly). Only this price grants access.
STRIPE_PRICE_ID=price_...
# Optional customer portal configuration (bpc_...).
STRIPE_PORTAL_CONFIGURATION_ID=
# Signing secret of the webhook endpoint for https://<your-domain>/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
