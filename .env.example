# Copy to .env.local and fill in real values from:
# Supabase Dashboard -> Project Settings -> API keys / Database

SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Public / client-side (safe to expose in a browser bundle)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server-side only. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=

# SECRET — direct Postgres access (migrations, psql, ORM CLI). Never expose client-side.
SUPABASE_DB_PASSWORD=
DATABASE_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres

# SECRET — server-side only.
ANTHROPIC_API_KEY=
