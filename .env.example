# Zeno Meeting Intelligence — copy to .env.local and fill in real values.
# Names only. Never commit real values: .gitignore ignores every .env* file.

# --- Anthropic: reasoning and tool use (server-only) ---
ANTHROPIC_API_KEY=
# Optional model overrides.
# ZENO_LIVE_MODEL=
# ZENO_REPORT_MODEL=

# --- Recall.ai: meeting bots, real-time transcription, chat, Output Media ---
# One of: us-west-2 | us-east-1 | eu-central-1 | ap-northeast-1
RECALL_REGION=
RECALL_API_KEY=
# Workspace verification secret (starts with whsec_). Verifies every request Recall
# sends us: dashboard webhooks, real-time endpoints and callbacks.
WEBHOOK_SECRET=

# --- ElevenLabs: speech for VOICE mode only ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- App ---
# Public HTTPS base URL Recall can reach (Railway domain, or a static ngrok URL locally).
APP_BASE_URL=
# Postgres connection string. Use memory: for a throwaway in-process store (demo/tests only).
DATABASE_URL=
PORT=8080
