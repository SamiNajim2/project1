# Copy to .env.local and fill in real values.

# --- Anthropic (server-only) ---
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-opus-5.
# ANTHROPIC_MODEL=

# --- Supabase: Dashboard -> Project Settings -> API keys ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SECRET, server-only. Bypasses Row Level Security (creates users, writes subscriptions).
SUPABASE_SECRET_KEY=sb_secret_...

# Used only to run supabase/migrations by hand (session pooler, IPv4).
SUPABASE_DB_PASSWORD=
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Stripe: Dashboard -> Developers -> API keys (use sk_test_ keys in the sandbox) ---
STRIPE_SECRET_KEY=sk_test_...
# The $20/month recurring price (lookup key strategy_agent_pro_monthly).
STRIPE_PRICE_ID=price_...
# Optional: customer portal configuration (bpc_...). Omit to use the account default.
STRIPE_PORTAL_CONFIGURATION_ID=
# Signing secret of the webhook endpoint for https://<your-domain>/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_...
